package model;

public class Aluno {
	
	private String nome;
	private double[] notas = new double[4];
	private double media;
	
	public Aluno() {
		super();
	}

	public Aluno(String nome, double[] notas, double media) {
		super();
		this.nome = nome;
		this.notas = notas;
		this.media = media;
	}
	
	
	
}
